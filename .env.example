# ============================================================
#  QR Shield — environment settings
#
#  ONE file, BOTH machines. The app works out where it is running
#  (config/env.php) and reads only the matching block:
#
#     on XAMPP / localhost  ->  the DB_* values below
#     on InfinityFree       ->  the LIVE_DB_* values below
#
#  So you never edit this file when deploying. Upload it as-is.
#  Do NOT set APP_ENV here — leaving it out is what lets the app
#  decide for itself. Setting it forces BOTH machines into the
#  same mode, and one of them will then be wrong.
#
#  This file is gitignored. It never reaches GitHub.
# ============================================================

# ---- LOCAL (XAMPP) -----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=svts
DB_USER=root
DB_PASS=

# ---- LIVE (InfinityFree) -----------------------------------
LIVE_DB_HOST=sql206.infinityfree.com
LIVE_DB_PORT=3306
LIVE_DB_NAME=if0_42480644_svts
LIVE_DB_USER=if0_42480644
LIVE_DB_PASS=your-infinityfree-mysql-password
